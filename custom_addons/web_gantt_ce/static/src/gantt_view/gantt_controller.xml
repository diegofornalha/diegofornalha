<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web_gantt_ce.GanttController">
        <Layout className="'o_gantt_view'" display="props.display">
            <t t-set-slot="control-panel-additional-actions">
                <div class="d-flex gap-2 align-items-center">
                    <!-- Filtro por responsável -->
                    <select class="o_gantt_user_selector form-select" t-on-change="onUserFilterSelectChange" t-att-value="state.filterUserId || ''">
                        <option value="">👥 Todos</option>
                        <t t-foreach="assignedUsers" t-as="user" t-key="user.id">
                            <option t-att-value="user.id">
                                <t t-esc="user.name"/>
                            </option>
                        </t>
                    </select>
                    <select class="o_gantt_scale_selector form-select" t-on-change="onScaleChange">
                        <t t-foreach="scales" t-as="scale" t-key="scale">
                            <option t-att-value="scale" t-att-selected="scale === state.scale">
                                <t t-esc="scale"/>
                            </option>
                        </t>
                    </select>
                    <!-- Seletor de prioridade - só aparece quando há tarefa selecionada -->
                    <t t-if="state.selectedTask">
                        <!-- Nome da tarefa clicável (abre o formulário) -->
                        <button class="o_gantt_task_name_btn btn btn-light" t-att-title="state.selectedTask.name" t-on-click="onOpenSelectedTask">
                            🎨 <t t-esc="state.selectedTask.name.substring(0, 12)"/><t t-if="state.selectedTask.name.length > 12">...</t>
                        </button>
                        <!-- Dropdown de prioridade separado -->
                        <select class="o_gantt_priority_selector form-select" t-on-change="onPrioritySelectChange" t-att-value="state.selectedTask.priority">
                            <t t-foreach="priorities" t-as="priority" t-key="priority.value">
                                <option t-att-value="priority.value">
                                    <t t-esc="priority.label"/>
                                </option>
                            </t>
                        </select>
                    </t>
                </div>
            </t>
            <t t-set-slot="layout-actions"/>
            <div class="o_gantt_content h-100">
                <GanttRenderer t-props="rendererProps"/>
            </div>
        </Layout>
    </t>
</templates>
