<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_gantt_ce.GanttController.controlButtons">
        <div class="d-flex gap-1">
            <div class="btn-group">
                <button class="btn btn-secondary o_gantt_button_prev" t-on-click="() => this.setDate('previous')">
                    <i class="fa fa-chevron-left"/>
                </button>
                <button class="btn btn-secondary o_gantt_button_today" t-on-click="() => this.setDate('today')">
                    Hoje
                </button>
                <button class="btn btn-secondary o_gantt_button_next" t-on-click="() => this.setDate('next')">
                    <i class="fa fa-chevron-right"/>
                </button>
            </div>
        </div>
    </t>

    <t t-name="web_gantt_ce.GanttController">
        <Layout display="props.display" className="'o_gantt_view h-100'">
            <t t-set-slot="control-panel-additional-actions">
                <ViewScaleSelector
                    scales="scales"
                    currentScale="state.scale"
                    setScale.bind="setScale"
                    scaleLabels="scaleLabels"
                />
            </t>
            <t t-set-slot="layout-buttons">
                <t t-if="props.buttonTemplate" t-call="{{ props.buttonTemplate }}"/>
            </t>
            <t t-set-slot="layout-actions"/>
            <div class="o_gantt_view_container h-100">
                <t t-component="props.Renderer" t-props="rendererProps"/>
            </div>
        </Layout>
    </t>
</templates>
