<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="minimal_record_view_list" model="ir.ui.view">
        <field name="name">teste_funcional.record.view.list</field>
        <field name="model">teste_funcional.record</field>
        <field name="arch" type="xml">
            <list string="Teste Funcional">
                <field name="name"/>
                <field name="active"/>
                <field name="display_name"/>
            </list>
        </field>
    </record>

    <record id="minimal_record_view_form" model="ir.ui.view">
        <field name="name">teste_funcional.record.view.form</field>
        <field name="model">teste_funcional.record</field>
        <field name="arch" type="xml">
            <form string="Teste Funcional">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="minimal_action_record" model="ir.actions.act_window">
        <field name="name">Teste Funcional</field>
        <field name="res_model">teste_funcional.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>