<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adicionar campo de canal de notificação na view de projeto -->
    <record id="view_project_project_form_inherit_notification" model="ir.ui.view">
        <field name="name">project.project.form.inherit.notification</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="notification_channel_id"
                       placeholder="Selecione um canal para notificações..."
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Adicionar campo na view kanban de configurações do projeto -->
    <record id="view_project_project_kanban_inherit_notification" model="ir.ui.view">
        <field name="name">project.project.kanban.inherit.notification</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="notification_channel_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
