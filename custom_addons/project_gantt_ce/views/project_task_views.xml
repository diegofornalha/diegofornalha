<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Gantt View for Project Tasks -->
    <record id="view_project_task_gantt" model="ir.ui.view">
        <field name="name">project.task.gantt</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <gantt date_start="date_start"
                   date_stop="date_deadline"
                   default_group_by="user_ids"
                   color="project_id"
                   progress="progress"
                   default_scale="week"
                   string="Gantt de Tarefas">
                <field name="name"/>
                <field name="user_ids"/>
                <field name="project_id"/>
                <field name="stage_id"/>
                <field name="priority"/>
            </gantt>
        </field>
    </record>

    <!-- Add Gantt to Project Tasks action -->
    <record id="project.action_view_all_task" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form,calendar,gantt,activity</field>
    </record>
</odoo>
